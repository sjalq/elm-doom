{
    "type": "package",
    "name": "sjalq/elm-doom",
    "summary": "The 1993 Doom engine (DOS v1.9), frame for frame, as a pure Elm program",
    "license": "GPL-2.0",
    "version": "1.0.0",
    "exposed-modules": {
        "Running the game": [
            "Doom",
            "Doom.Config",
            "Doom.Event"
        ],
        "Showing it": [
            "Doom.Screen",
            "Doom.Video"
        ],
        "Sound and music": [
            "Doom.Audio",
            "Doom.Audio.Midi"
        ],
        "WAD files": [
            "Doom.Wad"
        ]
    },
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "elm/bytes": "1.0.8 <= v < 2.0.0",
        "elm/core": "1.0.5 <= v < 2.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.2.0 <= v < 3.0.0"
    }
}
