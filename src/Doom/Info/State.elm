{-| The value at a position in the C source's enum, if there is one.
-}
fromIndex : Int -> Maybe State
fromIndex i =
    Array.get i all


{-| One row of `states[]`. `frame` keeps C's FF\_FULLBRIGHT bit (0x8000); `tics` is -1
for a state that lasts forever.
-}
type alias Def =
    { sprite : Sprite
    , frame : Int
    , tics : Int
    , action : Maybe Action
    , next : State
    , misc1 : Int
    , misc2 : Int
    }


{-| The row for a state.
-}
def : State -> Def
def state =
    case Array.get (index state) defs of
        Just d ->
            d

        Nothing ->
            -- Unreachable: defs has a row for every State, in index order.
            { sprite = Sprite.Troo, frame = 0, tics = -1, action = Nothing, next = Null, misc1 = 0, misc2 = 0 }


